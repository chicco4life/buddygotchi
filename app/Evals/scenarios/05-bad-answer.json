{
  "name": "A bad answer or a brain error is contained",
  "why": "HARNESS.md §3 step 4: calls off the menu drop the whole pass, as does a classifier error; the next input gets the mode's reaction",
  "steps": [
    {"input": {"at": "0m", "event": "turn started", "agent": "claude", "project": "jetpack"},
     "expect": {"chatty": ["agent started → react(feeling: curious, word: hmm|what|oh|okay|code|more|wow|hi|none)"],
                "normal": ["agent started → nothing"],
                "calm": ["agent started → nothing"]}},
    {"input": {"at": "12m", "event": "turn finished", "agent": "claude", "project": "jetpack"}, "classifier": {"calls": [{"tool": "react", "feeling": "happy"}, {"tool": "react", "feeling": "proud"}]},
     "expect": ["agent finished → dropped (off menu)"]},
    {"input": {"at": "13m", "event": "turn started", "agent": "claude", "project": "jetpack"},
     "expect": {"chatty": ["agent started → react(feeling: curious, word: hmm|what|oh|okay|code|more|wow|hi|none)"],
                "normal": ["agent started → nothing"],
                "calm": ["agent started → nothing"]}},
    {"input": {"at": "25m", "event": "turn finished", "agent": "claude", "project": "jetpack"}, "classifier": {"error": "model crashed"},
     "expect": ["agent finished → dropped (error)"]},
    {"input": {"at": "26m", "event": "turn started", "agent": "claude", "project": "jetpack"},
     "expect": {"chatty": ["agent started → react(feeling: curious, word: hmm|what|oh|okay|code|more|wow|hi|none)"],
                "normal": ["agent started → nothing"],
                "calm": ["agent started → nothing"]}},
    {"input": {"at": "38m", "event": "turn finished", "agent": "claude", "project": "jetpack"},
     "expect": {"chatty": ["agent finished → react(feeling: excited, word: finally|yay|hooray|whee|wow|done|nice|good)"],
                "normal": ["agent finished → react(feeling: proud, word: finally|done|yay|hooray|whee|nice|good|wow)"],
                "calm": ["agent finished → nothing"]}}
  ]
}
