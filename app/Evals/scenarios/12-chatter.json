{
  "name": "Working chatter keeps the mode's pace, and calm cheers only a very long turn",
  "why": "BEHAVIORS.md §2 and §6: while an agent works, the rules chatter every 45–90 s in chatty, every 2–4 minutes in normal, and never in calm; a 10-minute turn gets the cheer in every mode",
  "rules": true,
  "steps": [
    {"input": {"at": "0s", "event": "turn started", "agent": "claude", "project": "landing"},
     "expect": {"chatty": ["agent started → react(feeling: curious, word: hmm|what|oh|okay|code|more|wow|hi|none)"],
                "normal": ["agent started → nothing"],
                "calm": ["agent started → nothing"]}},
    {"input": {"at": "10s", "event": "command", "agent": "claude", "project": "landing", "topic": "tests"},
     "expect": {"chatty": ["rules → mumble(feeling: happy)",
                           "rules → mumble(feeling: happy)",
                           "rules → mumble(feeling: curious, word: tests)",
                           "rules → mumble(feeling: happy)",
                           "rules → mumble(feeling: happy)",
                           "rules → mumble(feeling: curious, word: tests)",
                           "rules → mumble(feeling: happy)",
                           "rules → mumble(feeling: curious, word: tests)"],
                "normal": ["rules → mumble(feeling: happy)",
                           "rules → mumble(feeling: happy)"],
                "calm": []}},
    {"input": {"at": "10m", "event": "turn finished", "agent": "claude", "project": "landing"},
     "expect": {"chatty": ["rules → cheer", "agent finished → react(feeling: excited, word: finally|yay|hooray|whee|wow|done|nice|good)"],
                "normal": ["rules → cheer", "agent finished → react(feeling: proud, word: finally|done|yay|hooray|whee|nice|good|wow)"],
                "calm": ["rules → cheer", "agent finished → nothing"]}}
  ]
}
