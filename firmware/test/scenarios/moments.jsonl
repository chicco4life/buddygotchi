// Every animation (BEHAVIORS.md §5), at a characteristic frame.
{"clock":0}
{"t":"state","v":1,"base":"idle"}
{"clock":10000}
{"t":"moment","anim":"cheer","ttl":5}
{"clock":10190}
{"expect":{"moment":{"anim":"cheer"}}}
{"shot":"cheer"}
{"clock":11999}
{"expect":{"moment":{"anim":"cheer","left_ms":1}}}
{"clock":12000}
{"expect":{"moment":null}}
{"t":"state","v":1,"base":"idle"}
{"clock":30000}
{"t":"moment","anim":"wiggle","ttl":5}
{"clock":30090}
{"expect":{"moment":{"anim":"wiggle"}}}
{"shot":"wiggle"}
{"t":"state","v":1,"base":"idle"}
{"clock":40000}
{"t":"moment","anim":"listening","ttl":5}
{"clock":40400}
{"expect":{"moment":{"anim":"listening"}}}
{"shot":"listening"}
{"t":"state","v":1,"base":"idle"}
// The empty moment ends listening and does nothing else (PROTOCOL.md §3):
// the face blends back.
{"clock":45000}
{"t":"moment","ttl":5}
{"expect":{"moment":null,"audio":{"playing":false}}}
{"clock":45075}
{"shot":"listening-stopped-75ms"}
// It never ends a cheer.
{"clock":50000}
{"t":"moment","anim":"cheer","ttl":5}
{"clock":50500}
{"t":"moment","ttl":5}
{"expect":{"moment":{"anim":"cheer","left_ms":1500}}}
{"t":"state","v":1,"base":"idle"}
// An unknown animation with no mumble is ignored, the removed ones too.
{"clock":70000}
{"t":"moment","anim":"oops","ttl":5}
{"expect":{"moment":null}}
{"t":"moment","anim":"nod","ttl":5}
{"t":"moment","anim":"thinking","ttl":5}
{"t":"moment","anim":"shrug","ttl":5}
{"expect":{"moment":null}}
