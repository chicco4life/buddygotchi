// The bubble: squiggles for gibberish and the one real word in amber (UX.md
// §2). A mumble on its own plays over whatever face is showing (BEHAVIORS.md
// §5): here, working.
{"clock":0}
{"t":"state","v":1,"base":"working","busy":1}
{"clock":1000}
{"t":"moment","anim":"cheer","say":{"syl":"bi do ba na","word":"done!","at":4,"tune":"up","ms":120},"ttl":5}
{"clock":1400}
{"shot":"word-at-end"}
{"clock":10000}
{"t":"state","v":1,"base":"working","busy":1}
{"t":"moment","say":{"syl":"ma-po li","word":"tests?","at":0,"tune":"up","ms":120},"ttl":5}
{"expect":{"moment":null,"audio":{"playing":true,"syllables":3}}}
{"clock":10400}
{"shot":"word-at-start"}
{"clock":20000}
{"t":"state","v":1,"base":"working","busy":1}
{"t":"moment","say":{"syl":"ma-po li bu-da","tune":"bounce","ms":120},"ttl":5}
{"clock":20400}
{"shot":"no-word"}
{"clock":30000}
{"t":"state","v":1,"base":"working","busy":1}
{"t":"moment","say":{"syl":"po po","word":"refactoring","at":1,"tune":"flat","ms":120},"ttl":5}
{"clock":30400}
{"shot":"long-word"}
// (2 syllables + 2 beats for the word) × 120 ms, then 1.2 s to read it.
{"clock":31679}
{"expect":{"audio":{"syllables":2}}}
{"clock":31680}
{"expect":{"moment":null,"audio":{"playing":false,"syllables":0}}}
{"clock":34000}
{"shot":"bubble-gone"}
// Over an animation, a mumble leaves it playing.
{"t":"state","v":1,"base":"idle"}
{"clock":40000}
{"t":"moment","anim":"cheer","ttl":5}
{"clock":40300}
{"t":"moment","say":{"syl":"ba-na po","word":"yay","at":3,"tune":"up","ms":120},"ttl":5}
{"expect":{"moment":{"anim":"cheer","left_ms":1700},"audio":{"playing":true,"syllables":3}}}
{"clock":40500}
{"shot":"over-cheer"}
// The reply to push-to-talk ends listening's wait (BEHAVIORS.md §3.3).
{"t":"state","v":1,"base":"idle"}
{"clock":50000}
{"input":{"press":"hold","ms":600}}
{"clock":50400}
{"expect":{"moment":{"anim":"listening"}}}
{"clock":50600}
{"expect":{"moment":{"anim":"listening","left_ms":8000}}}
{"clock":51000}
{"t":"moment","say":{"syl":"mi-ne po","word":"hello","at":3,"tune":"lift","ms":120},"ttl":5}
{"expect":{"moment":null,"audio":{"playing":true,"syllables":3}}}
{"clock":51400}
{"shot":"reply-after-talk"}
// Quiet: nothing plays.
{"t":"state","v":1,"base":"idle","quiet":30}
{"clock":60000}
{"t":"moment","say":{"syl":"ba po","ms":120},"ttl":5}
{"expect":{"moment":null,"audio":{"syllables":0}}}
