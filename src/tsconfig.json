{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist-tsc",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@inputs/*": ["src/inputs/*"],
      "@outputs/*": ["src/outputs/*"],
      "@schema/*": ["schema/*"]
    }
  },
  "include": ["src/**/*.ts", "schema/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-tsc", "outputs/esp32"]
}
