# Required in production. Provided by Vercel when the Neon database is linked.
DATABASE_URL=

# Test-only fallback for Playwright and local smoke checks without Postgres.
ALLOW_INMEM=

# Public site URL for metadata and generated referral links.
NEXT_PUBLIC_SITE_URL=https://adoptaboop.com

# Optional transactional email sending via Resend. Unset skips sends fail-open.
RESEND_API_KEY=

# Hidden by default. Set to true only when the counter is backed by real data.
NEXT_PUBLIC_SHOW_COUNTER=

# Optional Stripe Payment Link for the refundable $5 deposit step on /welcome.
NEXT_PUBLIC_STRIPE_DEPOSIT_URL=

# Signing secret (whsec_…) for the Stripe deposit webhook at
# /api/stripe/webhook. Unset → the webhook no-ops (deposits still work; they
# just aren't auto-recorded onto the signup row).
STRIPE_WEBHOOK_SECRET=

# Optional ad pixels. Leave unset until the demand-test accounts exist.
NEXT_PUBLIC_REDDIT_PIXEL_ID=
NEXT_PUBLIC_TWITTER_PIXEL_ID=
NEXT_PUBLIC_META_PIXEL_ID=
