<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparkle appcast for the Boop Mac app (SUFeedURL in app/Boop/Resources/Info.plist).
  An empty channel means "no updates available" — Sparkle handles it cleanly.
  Release items are generated by app/tools/make-appcast.sh at release time
  (RELEASE.md step 10); paste the generated <item> entries into this channel.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>Boop</title>
    <link>https://adoptaboop.com/releases/appcast.xml</link>
    <description>Boop app updates.</description>
    <language>en</language>
  </channel>
</rss>
