{
  "name": "Tests that keep failing make Boop grumpy, and passing at last makes it proud",
  "why": "harness/EXAMPLE.md and plan/steering/mood/: a failure being worked through may make Boop determined, and its face with it, the third in a row turns it grumpy with a grumpy 'again', and the pass after it is a comeback, 'finally', that leaves grumpy for proud straight away",
  "steps": [
    {"event": "turn started", "at": "0s", "workspace": "fix-nav"},
    {"event": "command", "at": "1m", "workspace": "fix-nav", "topic": "tests", "failed": true,
     "expect": {"react": "none|curious|determined|grumpy", "mood": "happy|determined"}},
    {"event": "command", "at": "3m", "workspace": "fix-nav", "topic": "tests", "failed": true,
     "expect": {"react": "determined|grumpy|curious|none", "mood": "happy|determined"}},
    {"event": "command", "at": "5m", "workspace": "fix-nav", "topic": "tests", "failed": true,
     "expect": {"react": "grumpy", "word": "again|tests|ugh", "mood": "grumpy"}},
    {"event": "command", "at": "7m", "workspace": "fix-nav", "topic": "tests", "failed": false,
     "expect": {"react": "proud|excited|happy", "word": "finally|tests|yay", "mood": "proud|happy"}}
  ]
}
