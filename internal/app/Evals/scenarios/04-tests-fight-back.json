{
  "name": "Tests that keep failing make Boop grumpy, and passing at last makes it proud",
  "why": "harness/EXAMPLE.md: the third failure in a row turns a cheerful Boop grumpy, with an annoyed 'again'; the pass after it is a comeback, 'finally', and grumpy leaves once something that kept failing works (more than 10 minutes after it came)",
  "steps": [
    {"event": "turn started", "at": "0s", "workspace": "fix-nav"},
    {"event": "command", "at": "1m", "workspace": "fix-nav", "topic": "tests", "failed": true,
     "expect": {"react": "none|curious|annoyed", "mood": "cheerful"}},
    {"event": "command", "at": "3m", "workspace": "fix-nav", "topic": "tests", "failed": true,
     "expect": {"react": "annoyed|curious|none", "mood": "cheerful"}},
    {"event": "command", "at": "5m", "workspace": "fix-nav", "topic": "tests", "failed": true,
     "expect": {"react": "annoyed", "word": "again|tests|ugh", "mood": "grumpy"}},
    {"event": "command", "at": "16m", "workspace": "fix-nav", "topic": "tests", "failed": false,
     "expect": {"react": "proud|excited|happy", "word": "finally|tests|yay", "mood": "cheerful"}}
  ]
}
