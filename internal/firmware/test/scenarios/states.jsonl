// What the agents are doing (PROTOCOL.md §3 `act`): while working, the
// device draws that state's design in working's place, in the mood, from
// the Mac's variation. A new one starts from its beginning behind a blink:
// a new mood's flip-book shows its own blink step to hide the switch.
{"clock":0}
{"t":"state","v":1,"base":"working","act":"terminal","busy":1,"variant":1}
{"clock":1500}
{"expect":{"act":"terminal","look_variant":1,"moment":null}}
{"shot":"terminal"}
{"t":"state","v":1,"base":"working","act":"analyzing","mood":"calm","busy":1,"variant":2}
{"clock":1575}
{"shot":"to-analyzing-calm-75ms"}
{"clock":3000}
{"expect":{"act":"analyzing","mood":"calm","look_variant":2}}
{"shot":"analyzing-calm"}
// One it doesn't know is working's design.
{"t":"state","v":1,"base":"working","act":"juggling","mood":"calm","busy":1}
{"expect":{"act":null}}
// The rules' one-shots (BEHAVIORS.md §3.1) play once in Boop's mood, the
// variation the Mac names when it's one for the moment's context, then
// the look comes back behind a blink. Starting a new task, happy, over
// testing: its 3.8 s design.
{"clock":10000}
{"t":"state","v":1,"base":"working","act":"testing","mood":"happy","busy":1}
{"t":"moment","anim":"starting","ctx":"new_task"}
{"expect":{"moment":{"anim":"starting","left_ms":3800,"variant":1}}}
{"clock":11000}
{"shot":"starting-new-task"}
{"clock":13799}
{"expect":{"moment":{"anim":"starting","left_ms":1}}}
{"clock":13800}
{"expect":{"moment":null,"act":"testing"}}
{"clock":13875}
{"shot":"back-to-testing-75ms"}
// A session resumed: carrying on, the continuation's design, whatever
// variation the Mac named.
{"clock":15000}
{"t":"moment","anim":"starting","variant":1,"ctx":"continuation"}
{"expect":{"moment":{"anim":"starting","variant":3}}}
// Stopped, engaged, idle: the Mac's second variation.
{"clock":20000}
{"t":"state","v":1,"base":"idle","mood":"engaged"}
{"t":"moment","anim":"stopped","variant":2}
{"expect":{"moment":{"anim":"stopped","left_ms":5734,"variant":2}}}
{"clock":21000}
{"shot":"stopped-engaged"}
// A failed command, grumpy.
{"clock":30000}
{"t":"state","v":1,"base":"working","mood":"grumpy","busy":1}
{"t":"moment","anim":"error","variant":1}
{"expect":{"moment":{"anim":"error","left_ms":2888}}}
{"clock":31000}
{"shot":"error-grumpy"}
// A helper back, wounded, over delegating.
{"clock":40000}
{"t":"state","v":1,"base":"working","act":"delegating","mood":"wounded","busy":1}
{"t":"moment","anim":"helper_return","variant":3}
{"expect":{"moment":{"anim":"helper_return","left_ms":7410,"variant":3}}}
{"clock":41500}
{"shot":"helper-return-wounded"}
// None plays while something needs you, or while listening waits for the
// reply, which a one-shot never ends.
{"clock":50000}
{"t":"state","v":1,"base":"working","busy":1,"attn":{"agent":"claude","project":"landing","more":0}}
{"t":"moment","anim":"error","variant":1}
{"expect":{"screen":"needs_you","moment":null}}
{"t":"state","v":1,"base":"working","busy":1}
{"t":"moment","anim":"listening","variant":1}
{"t":"moment","anim":"starting","ctx":"new_task"}
{"t":"moment","anim":"helper_return"}
{"expect":{"moment":{"anim":"listening"}}}
{"t":"moment"}
{"expect":{"moment":null}}
