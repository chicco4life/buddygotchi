// Switching designs: the eyes shut for 150 ms to hide each cut, and a
// switch mid-switch shuts them again from there (UX.md §2).
{"clock":0}
{"t":"state","v":1,"base":"idle"}
{"clock":1000}
{"t":"state","v":1,"base":"working","busy":1}
{"clock":1050}
{"shot":"idle-to-working-50ms"}
{"clock":1100}
{"shot":"idle-to-working-100ms"}
{"clock":1150}
{"shot":"idle-to-working-150ms"}
{"t":"moment","anim":"cheer"}
{"clock":1225}
{"shot":"to-cheer-75ms"}
{"t":"moment","anim":"wiggle"}
{"clock":1300}
{"shot":"interrupted-75ms"}
{"expect":{"moment":{"anim":"wiggle"}}}
// The wiggle ends after 700 ms; it kept working's design, so no blink.
{"clock":1925}
{"expect":{"moment":null}}
{"clock":2000}
{"shot":"back-to-working-75ms"}
