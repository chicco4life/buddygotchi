// Every animation (BEHAVIORS.md §5), at a characteristic frame. The cheer
// plays its `loops` of happy's task-complete design (6.4 s), one when the
// moment doesn't say. With `who`, the strip names whose turn it cheers.
{"clock":0}
{"t":"state","v":1,"base":"idle"}
{"clock":10000}
{"t":"moment","anim":"cheer"}
{"clock":10190}
{"expect":{"moment":{"anim":"cheer"}}}
{"shot":"cheer"}
{"clock":16399}
{"expect":{"moment":{"anim":"cheer","left_ms":1}}}
{"clock":16400}
{"expect":{"moment":null}}
{"t":"state","v":1,"base":"idle","busy":2}
{"clock":20000}
{"t":"moment","anim":"cheer","who":{"agent":"codex","thread":"landing-page-redesig.."}}
{"clock":20190}
{"shot":"cheer_who"}
{"clock":26400}
{"expect":{"moment":null}}
{"t":"state","v":1,"base":"idle"}
{"clock":30000}
{"t":"moment","anim":"wiggle"}
{"clock":30090}
{"expect":{"moment":{"anim":"wiggle"}}}
{"shot":"wiggle"}
{"t":"state","v":1,"base":"idle"}
// A moment with neither `anim` nor `say` is ignored (PROTOCOL.md §3): the
// cheer carries on.
{"clock":50000}
{"t":"moment","anim":"cheer"}
{"clock":50500}
{"t":"moment"}
{"expect":{"moment":{"anim":"cheer","left_ms":5900}}}
{"t":"state","v":1,"base":"idle"}
// An unknown animation with no mumble is ignored, the removed ones too.
{"clock":70000}
{"t":"moment","anim":"oops"}
{"expect":{"moment":null}}
{"t":"moment","anim":"nod"}
{"t":"moment","anim":"thinking"}
{"t":"moment","anim":"shrug"}
{"expect":{"moment":null}}
// Two loops: the design plays again from its start, so 190 ms into the
// second loop looks as 190 ms into the first.
{"t":"state","v":1,"base":"idle"}
{"clock":90000}
{"t":"moment","anim":"cheer","loops":2}
{"expect":{"moment":{"anim":"cheer","left_ms":12800}}}
{"clock":96590}
{"expect":{"moment":{"anim":"cheer","left_ms":6210}}}
{"shot":"cheer-second-loop"}
{"clock":102799}
{"expect":{"moment":{"anim":"cheer","left_ms":1}}}
{"clock":102800}
{"expect":{"moment":null}}
